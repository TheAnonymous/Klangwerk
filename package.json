{
  "name": "klangwerk",
  "version": "0.1.0",
  "description": "A small Web Audio music engine: voices, mixer, transport and the plumbing (iPhone silent switch, worker clock, offline render, WAV, recorder), with no dependencies.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src"
  ],
  "packageManager": "npm@12.0.0",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json --pretty false",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm test && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "24.10.0",
    "@typescript-eslint/eslint-plugin": "8.64.0",
    "@typescript-eslint/parser": "8.64.0",
    "eslint": "10.7.0",
    "globals": "16.5.0",
    "typescript": "5.9.3",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
